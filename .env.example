# Copy to .env on the VPS and fill in values: cp .env.example .env

POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=weather_db

SECRET_KEY=change_me_long_random_string

OPENWEATHER_API_KEY=
OPENWEATHER_LOCATION_URL=http://api.openweathermap.org/geo/1.0/direct
# On some VPS hosts HTTPS times out; use HTTP for both URLs.
OPENWEATHER_WEATHER_URL=http://api.openweathermap.org/data/2.5/weather
# Force IPv4 if the VPS has a broken IPv6 route (common).
OPENWEATHER_FORCE_IPV4=1
# OPENWEATHER_CONNECT_TIMEOUT=5
# OPENWEATHER_READ_TIMEOUT=60
# OPENWEATHER_RETRIES=5
# OPENWEATHER_RETRY_BACKOFF=1.0

# Optional: override SQL logging (default: on in development, off when ENVIRONMENT=production)
# SQL_ECHO=true
